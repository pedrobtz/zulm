#!/bin/sh
# Generate the variant build of design §13.1 from the vendored tree.
#
#   tools/gen-build
#
# Writes, and they are committed:
#   src/zlm_v/<set>/*.c|*.cpp  wrapper translation units: each defines the
#                              set's target macro, includes
#                              zlm_variant_begin.h, one ggml source, and
#                              zlm_variant_end.h
#   src/make/<arch>.mk         object lists and link rules per architecture,
#                              which configure appends to src/Makevars.in
#   src/Makevars.win           the Windows build (x86-64 variants)
#
# Run it after tools/vendor-ggml. No make extension is used, so the build
# needs no GNU make: R's suffix rules compile the wrappers, and every
# variant is one more shared object linked by an explicit rule.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here/src"

# Built once and linked into every variant: they hold no kernel.
COMMON_SRC="ggml.c ggml-alloc.c ggml-quants.c ggml-backend.cpp ggml-backend-meta.cpp
ggml-threading.cpp ggml-opt.cpp gguf.cpp ggml-cpu/ggml-cpu.cpp"
# Built once per variant, under the variant's target.
KERNEL_SRC="ggml-cpu/ggml-cpu.c ggml-cpu/quants.c ggml-cpu/repack.cpp ggml-cpu/hbm.cpp
ggml-cpu/traits.cpp ggml-cpu/amx/amx.cpp ggml-cpu/amx/mmq.cpp ggml-cpu/tiled/tiled.cpp
ggml-cpu/tiled/tiled-kernel.cpp ggml-cpu/binary-ops.cpp ggml-cpu/unary-ops.cpp
ggml-cpu/vec.cpp ggml-cpu/ops.cpp ggml-cpu/llamafile/sgemm.cpp"
X86_SRC="ggml-cpu/arch/x86/quants.c ggml-cpu/arch/x86/repack.cpp"
ARM_SRC="ggml-cpu/arch/arm/quants.c ggml-cpu/arch/arm/repack.cpp"
GLUE_OBJ="zlm_arrow.o zlm_dup.o zlm_glue.o zlm_graph.o zlm_log.o zlm_pool.o zlm_r.o zlm_rng.o zlm_shim.o zlm_st.o zlm_store.o zlm_train.o"

rm -rf zlm_v make
mkdir -p zlm_v make

# flat name: ggml-cpu/arch/x86/quants.c -> ggml-cpu_arch_x86_quants.c
flat() { echo "$1" | tr '/' '_'; }
obj() { echo "$1" | sed -E 's/\.(c|cpp)$/.o/'; }

# wrap <dir> <target-macro or -> <sources...>
wrap() {
  dir=$1; target=$2; shift 2
  mkdir -p "zlm_v/$dir"
  for s in "$@"; do
    f="zlm_v/$dir/$(flat "$s")"
    {
      echo "/* Generated by tools/gen-build; do not edit. */"
      [ "$target" != "-" ] && echo "#define $target 1"
      echo '#include "../../zlm_variant_begin.h"'
      echo "#include \"../../ggml/src/$s\""
      echo '#include "../../zlm_variant_end.h"'
    } > "$f"
  done
}

# init <dir> <variant name>
init() {
  {
    echo "/* Generated by tools/gen-build; do not edit. */"
    echo "#define ZLM_VARIANT $2"
    echo '#include "../../zlm_init.h"'
  } > "zlm_v/$1/zlm_init.c"
}

objects() { # <dir> <sources...>
  dir=$1; shift
  out="zlm_v/$dir/zlm_init.o"
  for s in "$@"; do out="$out zlm_v/$dir/$(obj "$(flat "$s")")"; done
  echo "$out"
}

wrap common - $COMMON_SRC
COMMON_OBJ="$GLUE_OBJ"
for s in $COMMON_SRC; do COMMON_OBJ="$COMMON_OBJ zlm_v/common/$(obj "$(flat "$s")")"; done

# set: <dir> <variant> <target-macro or -> <arch sources...>
sets="baseline:baseline:-:x86 sse42:sse42:ZLM_TARGET_SSE42:x86 avx2:avx2:ZLM_TARGET_AVX2:x86
neon:neon:-:arm generic:generic:-:none
native_x86:native:-:x86 native_arm:native:-:arm native_generic:native:-:none"
for spec in $sets; do
  IFS=: read -r dir name target arch <<EOS
$spec
EOS
  case $arch in
    x86) extra=$X86_SRC ;; arm) extra=$ARM_SRC ;; *) extra= ;;
  esac
  wrap "$dir" "$target" $KERNEL_SRC $extra
  init "$dir" "$name"
done

wrap_list() { # one object per line, continued
  printf '%s' "$1" | tr ' ' '\n' | sed 's/$/ \\/' | sed '$ s/ \\$//' | sed '2,$ s/^/  /'
}

# fragment <file> <dir:name ...>   (each pair: wrapper dir and variant name)
fragment() {
  file=$1; shift
  # Target names are expanded when make reads Makevars, before Makeconf
  # defines SHLIB_EXT, so the extension is written out.
  if [ "${ZLM_WIN:-0}" = 1 ]; then ext=.dll; else ext=.so; fi
  libs=""
  for p in "$@"; do libs="$libs zulm_${p#*:}$ext"; done
  {
    echo "# Generated by tools/gen-build; do not edit. Appended to Makevars.in"
    echo "# by configure (design §13.1, §13.4)."
    echo
    echo "ZLM_COMMON = $(wrap_list "$COMMON_OBJ")"
    echo
    echo "ZLM_VARIANTS =$libs"
    echo
    echo "all: \$(SHLIB) \$(ZLM_VARIANTS)"
    for p in "$@"; do
      dir=${p%%:*}; name=${p#*:}
      case $dir in
        baseline|sse42|avx2|native_x86) extra=$X86_SRC ;;
        neon|native_arm) extra=$ARM_SRC ;;
        *) extra= ;;
      esac
      echo
      echo "ZLM_OBJ_$name = $(wrap_list "$(objects "$dir" $KERNEL_SRC $extra)")"
      echo
      echo "zulm_$name$ext: \$(ZLM_COMMON) \$(ZLM_OBJ_$name)"
      if [ "${ZLM_WIN:-0}" = 1 ]; then
        printf '\t$(SHLIB_LD) -shared $(DLLFLAGS) -o $@ zlm_v/zulm_%s.def $(ZLM_COMMON) $(ZLM_OBJ_%s) $(ALL_LIBS)\n' "$name" "$name"
      else
        printf '\t$(SHLIB_LINK) -o $@ $(ZLM_COMMON) $(ZLM_OBJ_%s) $(ZLM_LDFLAGS_%s) $(ALL_LIBS)\n' "$name" "$name"
      fi
    done
  } > "make/$file"
}

fragment x86_64.mk baseline:baseline sse42:sse42 avx2:avx2
fragment arm64.mk neon:neon
fragment generic.mk generic:generic
fragment native_x86.mk native_x86:native
fragment native_arm.mk native_arm:native
fragment native_generic.mk native_generic:native

# Windows: x86-64 variants, linked with a .def file that exports only
# R_init_zulm_<variant> (design §13.3), and no native hook (design §13.4).
{
  echo "# Generated by tools/gen-build; do not edit. The Windows build of"
  echo "# design §13.1: the x86-64 variants, without the native hook (§13.4)."
  sed -n '/^CXX_STD/,$p' Makevars.in | sed -e 's/ \$(ZULM_CFLAGS)//' -e 's/ \$(ZULM_CXXFLAGS)//' \
    -e '/ZULM_CFLAGS and/,/^$/d'
  ZLM_WIN=1 fragment win.mk baseline:baseline sse42:sse42 avx2:avx2
  sed -e '1,3d' make/win.mk
  rm -f make/win.mk
} > Makevars.win
for v in baseline sse42 avx2; do
  printf 'LIBRARY zulm_%s.dll\nEXPORTS\n R_init_zulm_%s\n' "$v" "$v" > "zlm_v/zulm_$v.def"
done
echo "wrote $(find zlm_v -type f | wc -l | tr -d ' ') wrappers, $(ls make | wc -l | tr -d ' ') fragments, Makevars.win"
