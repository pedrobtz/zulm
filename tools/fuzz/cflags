#!/bin/sh
# The fuzz targets' compile flags: target number, variant, zurand's
# include directory. src/Makevars.in's PKG_CPPFLAGS, from the root.
echo "-DZLM_FUZZ_TARGET=$1 -DZLM_VARIANT=$2 -Isrc -Isrc/ggml/include -Isrc/ggml/src \
-Isrc/ggml/src/ggml-cpu -I$3 -DGGML_USE_CPU_REPACK -DGGML_USE_LLAMAFILE \
-DGGML_SCHED_MAX_COPIES=4 -DGGML_SCHED_MAX_SPLIT_INPUTS=4 -pthread"
