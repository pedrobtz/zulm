  zlm_v/avx2/ggml-cpu_quants.o \
  zlm_v/avx2/ggml-cpu_repack.o \
  zlm_v/avx2/ggml-cpu_hbm.o \
  zlm_v/avx2/ggml-cpu_traits.o \
  zlm_v/avx2/ggml-cpu_amx_amx.o \
  zlm_v/avx2/ggml-cpu_amx_mmq.o \
  zlm_v/avx2/ggml-cpu_tiled_tiled.o \
  zlm_v/avx2/ggml-cpu_tiled_tiled-kernel.o \
  zlm_v/avx2/ggml-cpu_binary-ops.o \
  zlm_v/avx2/ggml-cpu_unary-ops.o \
  zlm_v/avx2/ggml-cpu_vec.o \
  zlm_v/avx2/ggml-cpu_ops.o \
  zlm_v/avx2/ggml-cpu_llamafile_sgemm.o \
  zlm_v/avx2/ggml-cpu_arch_x86_quants.o \
  zlm_v/avx2/ggml-cpu_arch_x86_repack.o

zulm_avx2.dll: $(ZLM_COMMON) $(ZLM_OBJ_avx2)
	$(SHLIB_LD) -shared $(DLLFLAGS) -o $@ zlm_v/zulm_avx2.def $(ZLM_COMMON) $(ZLM_OBJ_avx2) $(ALL_LIBS)
