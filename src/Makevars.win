# Generated by tools/gen-build; do not edit. The Windows build of
# design §13.1: the x86-64 variants, without the native hook (§13.4).
CXX_STD = CXX17

# -I. finds zulm's headers, -Iggml/... the vendored tree (design §9.1).
# GGML_USE_CPU_REPACK and GGML_SCHED_MAX_COPIES as upstream's CMake sets
# them; GGML_SCHED_MAX_SPLIT_INPUTS=4, since the one CPU backend copies no
# split inputs and the scheduler reserves graph size x this x 2 tensors; GGML_USE_LLAMAFILE for llamafile's matrix kernels, 2.5-4x the plain
# ones and thread-invariant (design §13.1, question 7); -pthread where
# ggml's thread pool needs it (WRE §1.2.1 allows it in PKG_CPPFLAGS).
PKG_CPPFLAGS = -I. -Iggml/include -Iggml/src -Iggml/src/ggml-cpu \
  -DGGML_USE_CPU_REPACK -DGGML_USE_LLAMAFILE -DGGML_SCHED_MAX_COPIES=4 \
  -DGGML_SCHED_MAX_SPLIT_INPUTS=4 -pthread

PKG_CFLAGS = $(C_VISIBILITY)
PKG_CXXFLAGS = $(CXX_VISIBILITY)
PKG_LIBS = -pthread

# The registered DLL is the probe alone; the variants are linked below.
OBJECTS = zulm.o
ZLM_COMMON = zlm_arrow.o \
  zlm_dup.o \
  zlm_glue.o \
  zlm_graph.o \
  zlm_log.o \
  zlm_pool.o \
  zlm_r.o \
  zlm_rng.o \
  zlm_shim.o \
  zlm_st.o \
  zlm_store.o \
  zlm_train.o \
  zlm_v/common/ggml.o \
  zlm_v/common/ggml-alloc.o \
  zlm_v/common/ggml-quants.o \
  zlm_v/common/ggml-backend.o \
  zlm_v/common/ggml-backend-meta.o \
  zlm_v/common/ggml-threading.o \
  zlm_v/common/ggml-opt.o \
  zlm_v/common/gguf.o \
  zlm_v/common/ggml-cpu_ggml-cpu.o

ZLM_VARIANTS = zulm_baseline.dll zulm_sse42.dll zulm_avx2.dll

all: $(SHLIB) $(ZLM_VARIANTS)

ZLM_OBJ_baseline = zlm_v/baseline/zlm_init.o \
  zlm_v/baseline/ggml-cpu_ggml-cpu.o \
  zlm_v/baseline/ggml-cpu_quants.o \
  zlm_v/baseline/ggml-cpu_repack.o \
  zlm_v/baseline/ggml-cpu_hbm.o \
  zlm_v/baseline/ggml-cpu_traits.o \
  zlm_v/baseline/ggml-cpu_amx_amx.o \
  zlm_v/baseline/ggml-cpu_amx_mmq.o \
  zlm_v/baseline/ggml-cpu_tiled_tiled.o \
  zlm_v/baseline/ggml-cpu_tiled_tiled-kernel.o \
  zlm_v/baseline/ggml-cpu_binary-ops.o \
  zlm_v/baseline/ggml-cpu_unary-ops.o \
  zlm_v/baseline/ggml-cpu_vec.o \
  zlm_v/baseline/ggml-cpu_ops.o \
  zlm_v/baseline/ggml-cpu_llamafile_sgemm.o \
  zlm_v/baseline/ggml-cpu_arch_x86_quants.o \
  zlm_v/baseline/ggml-cpu_arch_x86_repack.o

zulm_baseline.dll: $(ZLM_COMMON) $(ZLM_OBJ_baseline)
	$(SHLIB_LD) -shared $(DLLFLAGS) -o $@ zlm_v/zulm_baseline.def $(ZLM_COMMON) $(ZLM_OBJ_baseline) $(ALL_LIBS)

ZLM_OBJ_sse42 = zlm_v/sse42/zlm_init.o \
