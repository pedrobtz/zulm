  zlm_v/sse42/ggml-cpu_tiled_tiled.o \
  zlm_v/sse42/ggml-cpu_tiled_tiled-kernel.o \
  zlm_v/sse42/ggml-cpu_binary-ops.o \
  zlm_v/sse42/ggml-cpu_unary-ops.o \
  zlm_v/sse42/ggml-cpu_vec.o \
  zlm_v/sse42/ggml-cpu_ops.o \
  zlm_v/sse42/ggml-cpu_llamafile_sgemm.o \
  zlm_v/sse42/ggml-cpu_arch_x86_quants.o \
  zlm_v/sse42/ggml-cpu_arch_x86_repack.o

zulm_sse42.dll: $(ZLM_COMMON) $(ZLM_OBJ_sse42)
	$(SHLIB_LD) -shared $(DLLFLAGS) -o $@ zlm_v/zulm_sse42.def $(ZLM_COMMON) $(ZLM_OBJ_sse42) $(ALL_LIBS)

ZLM_OBJ_avx2 = zlm_v/avx2/zlm_init.o \
